{
  "version": 1,
  "meta": {
    "name": "brewly-launch",
    "format": "9:16",
    "fps": 30,
    "resolution": "720p"
  },
  "theme": {
    "primary": "#C8864A",
    "secondary": "#F3E6D3",
    "background": "#3B2518",
    "text": "#FFF6EA",
    "font": "Poppins",
    "radius": 24
  },
  "assets": [],
  "scenes": [
    {
      "id": "s1",
      "block": "title-reveal",
      "duration": 2.5,
      "props": {
        "title": "Meet Brewly",
        "subtitle": "Your coffee, ready when you are ☕",
        "style": "rise",
        "align": "center"
      }
    },
    {
      "id": "s2",
      "block": "kinetic-text",
      "duration": 2,
      "props": {
        "lines": [
          "Skip the line.",
          "Sip sooner."
        ],
        "emphasis": [
          "Sip"
        ],
        "mode": "stack"
      },
      "transition": {
        "type": "slide",
        "duration": 0.5
      }
    },
    {
      "id": "s3",
      "block": "html",
      "duration": 3,
      "props": {
        "background": "#F3E6D3",
        "html": "<div class='wrap'><div class='head'>Order in 3 taps</div><div class='phone'><div class='notch'></div><div class='app'><div class='hi'>Good morning, Sam 👋</div><div class='card c1'><div class='cup'>☕</div><div><div class='nm'>Oat Latte</div><div class='pr'>Large · $4.80</div></div></div><div class='card c2'><div class='cup'>🥐</div><div><div class='nm'>Croissant</div><div class='pr'>Warm · $3.20</div></div></div><div class='btn'>Order now</div><div class='toast'>✓ Ready in 4 min</div></div></div></div>",
        "css": ".wrap{width:1080px;height:1920px;display:flex;flex-direction:column;align-items:center;font-family:Poppins,sans-serif;color:#3B2518}.head{margin-top:170px;font-size:84px;font-weight:700;opacity:0;animation:up .6s .1s forwards}.phone{margin-top:80px;width:640px;height:1280px;background:#2A1A10;border-radius:90px;padding:28px;box-shadow:0 40px 90px rgba(59,37,24,.35);opacity:0;animation:up .7s .2s forwards}.notch{width:200px;height:38px;background:#2A1A10;border-radius:0 0 24px 24px;margin:0 auto;position:relative;z-index:2}.app{background:#FFF6EA;border-radius:66px;height:1224px;margin-top:-38px;padding:110px 44px 0;box-sizing:border-box}.hi{font-size:40px;font-weight:600;margin-bottom:40px;white-space:nowrap}.card{display:flex;align-items:center;gap:28px;background:#fff;border-radius:32px;padding:30px;margin-bottom:28px;box-shadow:0 8px 24px rgba(59,37,24,.1);opacity:0}.c1{animation:up .5s .6s forwards}.c2{animation:up .5s .85s forwards}.cup{font-size:64px;width:110px;height:110px;flex:none;border-radius:28px;background:#F3E6D3;display:flex;align-items:center;justify-content:center}.nm{font-size:40px;font-weight:600;white-space:nowrap}.pr{font-size:30px;color:#8A6A52;margin-top:6px}.btn{margin-top:60px;background:#C8864A;color:#fff;font-size:44px;font-weight:700;text-align:center;padding:36px;border-radius:999px;opacity:0;animation:up .5s 1.1s forwards,tap .3s 1.7s}.toast{margin-top:40px;background:#3B2518;color:#FFF6EA;font-size:40px;font-weight:600;text-align:center;padding:34px;border-radius:32px;opacity:0;animation:up .5s 2s forwards}@keyframes up{from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:none}}@keyframes tap{50%{transform:scale(.94)}}"
      },
      "transition": {
        "type": "fade",
        "duration": 0.5
      }
    },
    {
      "id": "s4",
      "block": "html",
      "duration": 2.5,
      "props": {
        "background": "#3B2518",
        "html": "<div class='wrap'><div class='head'>Made for your <span>mornings</span></div><div class='row r1'><div class='ic'>⚡</div><div><div class='t'>Order ahead</div><div class='d'>No waiting around.</div></div></div><div class='row r2'><div class='ic'>❤️</div><div><div class='t'>Saved favourites</div><div class='d'>Your usual, one tap.</div></div></div><div class='row r3'><div class='ic'>🎁</div><div><div class='t'>Free rewards</div><div class='d'>Every 10th cup on us.</div></div></div></div>",
        "css": ".wrap{width:1080px;height:1920px;display:flex;flex-direction:column;justify-content:center;padding:0 90px;box-sizing:border-box;font-family:Poppins,sans-serif;color:#FFF6EA;background:radial-gradient(circle at 30% 20%,#5A3826,#3B2518 60%)}.head{font-size:88px;font-weight:800;line-height:1.1;margin-bottom:90px;opacity:0;animation:up .5s .05s forwards}.head span{color:#E0A56E}.row{display:flex;align-items:center;gap:44px;background:rgba(255,246,234,.08);border:2px solid rgba(255,246,234,.12);border-radius:40px;padding:44px 48px;margin-bottom:36px;opacity:0}.r1{animation:up .5s .3s forwards}.r2{animation:up .5s .5s forwards}.r3{animation:up .5s .7s forwards}.ic{font-size:64px;width:130px;height:130px;flex:none;border-radius:34px;background:linear-gradient(135deg,#C8864A,#F3E6D3);display:flex;align-items:center;justify-content:center}.t{font-size:52px;font-weight:700}.d{font-size:36px;color:#E8D6C0;margin-top:4px}@keyframes up{from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:none}}"
      },
      "transition": {
        "type": "slide",
        "duration": 0.5
      }
    },
    {
      "id": "s5",
      "block": "logo-outro",
      "duration": 2,
      "props": {
        "brand": "Brewly",
        "text": "Get Brewly at brewly.app",
        "cta": "Download free"
      },
      "transition": {
        "type": "zoom",
        "duration": 0.5
      }
    }
  ],
  "overlays": []
}
